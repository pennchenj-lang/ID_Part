{
  "format": "HPID game-prop and scene ontology extension",
  "format_version": "0.1.0",
  "new_domains": [
    {
      "name": "terrain",
      "classifier_prompt": "a broad continuous ground plane, landscape surface, path, cliff, water region, or game level floor",
      "root_prompts": [
        "terrain",
        "ground region",
        "landscape surface",
        "landscape",
        "outdoor game level",
        "game level ground",
        "cliff",
        "water region"
      ],
      "generic_root_prompts": ["terrain", "ground region", "landscape surface"],
      "default_part_semantics": [
        "terrain_ground",
        "terrain_path",
        "terrain_rock",
        "terrain_cliff",
        "terrain_water",
        "terrain_vegetation"
      ],
      "parts": [
        {
          "semantic_name": "terrain_ground",
          "prompts": ["walkable ground", "terrain ground", "floor surface"],
          "maximum_parent_fraction": 0.98,
          "maximum_instances": 8
        },
        {
          "semantic_name": "terrain_path",
          "prompts": ["path", "road", "trail", "walkway"],
          "semantic_parent": "terrain_ground",
          "maximum_parent_fraction": 0.85,
          "maximum_instances": 8
        },
        {
          "semantic_name": "terrain_rock",
          "prompts": ["terrain rock", "boulder", "rock outcrop"],
          "maximum_parent_fraction": 0.80,
          "maximum_instances": 16
        },
        {
          "semantic_name": "terrain_cliff",
          "prompts": ["cliff face", "rock wall", "terrain ledge"],
          "maximum_parent_fraction": 0.90,
          "maximum_instances": 8
        },
        {
          "semantic_name": "terrain_water",
          "prompts": ["water surface", "river", "lake", "pond"],
          "maximum_parent_fraction": 0.95,
          "maximum_instances": 8
        },
        {
          "semantic_name": "terrain_vegetation",
          "prompts": ["grass patch", "ground vegetation", "foliage patch"],
          "maximum_parent_fraction": 0.90,
          "maximum_instances": 24
        },
        {
          "semantic_name": "terrain_snow",
          "prompts": ["snow cover", "snow patch"],
          "maximum_parent_fraction": 0.95,
          "maximum_instances": 12
        },
        {
          "semantic_name": "terrain_sand",
          "prompts": ["sand surface", "sand patch", "desert ground"],
          "maximum_parent_fraction": 0.95,
          "maximum_instances": 12
        }
      ],
      "part_profiles": [
        {
          "name": "outdoor_level",
          "classifier_prompt": "a broad outdoor game level or landscape ground plane with paths, cliffs, water, and vegetation",
          "root_hints": ["outdoor game level", "landscape", "terrain"],
          "parts": [
            "terrain_ground",
            "terrain_path",
            "terrain_rock",
            "terrain_cliff",
            "terrain_water",
            "terrain_vegetation",
            "terrain_snow",
            "terrain_sand"
          ]
        }
      ]
    }
